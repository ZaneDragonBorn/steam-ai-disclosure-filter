{
  "name": "millennium-ai-disclosure-filter",
  "version": "0.7.15",
  "private": true,
  "author": "Zane Dragonborn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZaneDragonBorn/steam-ai-disclosure-filter.git"
  },
  "bugs": {
    "url": "https://github.com/ZaneDragonBorn/steam-ai-disclosure-filter/issues"
  },
  "homepage": "https://github.com/ZaneDragonBorn/steam-ai-disclosure-filter#readme",
  "type": "module",
  "scripts": {
    "dev": "starlight watch",
    "build": "starlight pack --release",
    "package": "node scripts/package.mjs",
    "prepare": "starlight lsp",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write frontend shared webview tests scripts *.json README.md docs/release-review.md",
    "format:check": "prettier --check frontend shared webview tests scripts *.json README.md docs/release-review.md"
  },
  "devDependencies": {
    "@steambrew/starlight": "1.1.3",
    "@types/jsdom": "21.1.7",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}